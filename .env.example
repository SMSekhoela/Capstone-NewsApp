# Example .env file for this Django project
# Copy this file to `.env` and fill values before running the project

# Django
SECRET_KEY=replace-me-with-a-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL by default) - set USE_MYSQL=false to use SQLite
USE_MYSQL=true
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Email (console backend used by default in settings)
DEFAULT_FROM_EMAIL=noreply@newsapp.local

# Add any third-party API keys below
# NEWS_API_KEY=your_news_api_key
